# Copie este arquivo para ".env" (mesma pasta) e preencha com valores reais.
# ".env" nunca deve ser commitado (já está no .gitignore).

# uid do usuário Firebase Auth dono do app (é o valor de user.uid no app,
# visível em Firestore > users, ou no console Firebase > Authentication).
OWNER_UID=

# itemId(s) do Titular 1, separados por vírgula caso tenha mais de uma conta/banco.
# Obtido no Pluggy Dashboard > sua aplicação > "Ir para Demo" > menu (⋮) > "Copiar Item ID".
PLUGGY_ITEM_IDS=

# Quando conectar o segundo CPF, descomente e preencha (além de criar os secrets
# PLUGGY_CLIENT_ID_2 / PLUGGY_CLIENT_SECRET_2 e o código correspondente em index.js).
# PLUGGY_ITEM_IDS_2=
